# ===== Travel With Chaudharys — Backend configuration (example) =====
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

PORT=5000
# Address the API listens on. Default 127.0.0.1 (this machine only); Docker uses 0.0.0.0.
# HOST=127.0.0.1

# ----- Admin authentication -----

# Comma-separated Google account emails allowed to access the admin panel.
ADMIN_EMAILS=you@gmail.com

# Admin password, stored HASHED. Make the line with:   npm run hash-password
# (asks for the password, checks it is strong: 12+ characters with upper and
# lower case, a number and a symbol). Use this instead of ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# Old plain-text password — only for servers not yet moved to the hash above.
# Delete this line once ADMIN_PASSWORD_HASH is set.
# ADMIN_PASSWORD=

# Two-factor sign-in (recommended). Make the line with:   npm run setup-mfa
# then add the key to an authenticator app on your phone.
ADMIN_TOTP_SECRET=

# Secret used to sign admin sessions — at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out immediately.
JWT_SECRET=replace-with-a-long-random-string

# Google OAuth Client ID from Google Cloud Console (https://console.cloud.google.com).
# Leave blank to disable "Sign in with Google".
GOOGLE_CLIENT_ID=

# ----- Production hardening -----

# Set on the live server. Silences the per-request logger (pm2 would otherwise
# grow a log line for every hit) and is the flag to branch on for prod-only rules.
# Also turns off Express's detailed error pages.
NODE_ENV=production

# Force the session cookie's Secure flag (HTTPS only). Normally detected from
# Nginx's X-Forwarded-Proto header; set true once the site is HTTPS-only.
# COOKIE_SECURE=true

# Extra origins allowed to call this API cross-origin. Normally leave unset: the
# website calls /api on its own domain, and with this unset no other site can.
# ALLOWED_ORIGINS=https://travelwithchaudhary.cloud,https://www.travelwithchaudhary.cloud
